# Copy to .env. Everything here is TESTNET ONLY and disposable by design.

# ---- chain ----
CHAIN_KEY=sepolia
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
HEDERA_RPC_URL=https://testnet.hashio.io/api
ARC_RPC_URL=            # TODO day 1: look up. chains.ts throws until this chain id is real.

# ---- keys (testnet only) ----
# Pays gas to relay execute(). Fund from a Sepolia faucet.
RELAYER_KEY=
# Used only when AGENT_SIGNER=local.
AGENT_KEY=
# Deploys the contracts.
DEPLOYER_KEY=

# ---- deploy inputs ----
AGENT_ADDRESS=
HUMAN_ADDRESS=0x70997970C51812dc3A010C7d01b50e0d17dc79C8
GATE_FUNDING_WEI=50000000000000000

# ---- agent ----
ANTHROPIC_API_KEY=
AGENT_SIGNER=local       # local | privy
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_WALLET_ID=

# ---- app ----
DATABASE_URL=postgresql://postgres:password@localhost:5432/tappy
