# The human's key. TESTNET ONLY. v1 keeps this on the laptop; M6 moves it onto the Flipper.
HUMAN_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d

# Where the backend's approval channel lives.
HUB_WS_URL=ws://localhost:3000/ws

# Serial port of the Flipper. Find it with: ls /dev/cu.usbmodem*
FLIPPER_PORT=/dev/cu.usbmodemflip_Flippy1
FLIPPER_BAUD=230400

# "flipper" uses the device; "mock" runs the same code path with a terminal y/n prompt.
SIGNER_KIND=flipper

# Chain the gate lives on, and the gate address (from packages/contracts/deployments).
CHAIN_KEY=sepolia
GATE_ADDRESS=0x0000000000000000000000000000000000000000
